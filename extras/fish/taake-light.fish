# name: TAAKE LIGHT colors for Fish
# url: https://fishshell.com/docs/current/index.html
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish/taake-light.fish
# author: Andrea Schiavini (original code by Casey Miller)

# use in ~/.config/fish/conf.d/

# preferred bg: e1d6df
# alt background: cdb7c6

### Full palette. 
### Colors defined in neomdern/palette/TAAKE LIGHT.lua
set -g alt 2d4f52 
set -g constant 504b26 
set -g comment 5d4658 
set -g fg 030203 
set -g func 64432b 
set -g keyword 5a4925 
set -g number 6f3c2f 
set -g operator 5d4156 
set -g property 030203 
set -g str 514733 
set -g type 57483d 

# Syntax Highlighting Colors
set -g fish_color_normal 030203
set -g fish_color_command 64432b
set -g fish_color_keyword 5a4925
set -g fish_color_quote 514733
set -g fish_color_redirection 504b26
set -g fish_color_end 5d4156
set -g fish_color_error a13b3b
set -g fish_color_param 030203
set -g fish_color_valid_path 57483d
set -g fish_color_option 2d4f52
set -g fish_color_comment 5d4658
set -g fish_color_selection --background=e1d6df
set -g fish_color_operator 5d4156
set -g fish_color_escape 5a4925
set -g fish_color_autosuggestion 5d4658
set -g fish_color_cwd 514733
set -g fish_color_hostname 6f3c2f
set -g fish_color_status a13b3b
set -g fish_color_cancel 6f3c2f
set -g fish_color_search_match --background=e1d6df

# Completion Pager Colors
set -g fish_pager_color_progress 2d4f52
set -g fish_pager_color_prefix 57483d
set -g fish_pager_color_completion 030203
set -g fish_pager_color_description 5d4658
set -g fish_pager_color_selected_prefix 2d4f52
set -g fish_pager_color_selected_completion 2d4f52
set -g fish_pager_color_selected_background --background=e1d6df
