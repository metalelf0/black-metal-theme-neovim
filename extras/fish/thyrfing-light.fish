# name: THYRFING LIGHT colors for Fish
# url: https://fishshell.com/docs/current/index.html
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish/thyrfing-light.fish
# author: Andrea Schiavini (original code by Casey Miller)

# use in ~/.config/fish/conf.d/

# preferred bg: f5dedb
# alt background: eabbb8

### Full palette. 
### Colors defined in neomdern/palette/THYRFING LIGHT.lua
set -g alt 2f5651 
set -g constant 614f2e 
set -g comment 634e4b 
set -g fg 170e0d 
set -g func 794134 
set -g keyword 7b4132 
set -g number 81374a 
set -g operator 634945 
set -g property 170e0d 
set -g str 99270a 
set -g type 912f18 

# Syntax Highlighting Colors
set -g fish_color_normal 170e0d
set -g fish_color_command 794134
set -g fish_color_keyword 7b4132
set -g fish_color_quote 99270a
set -g fish_color_redirection 614f2e
set -g fish_color_end 634945
set -g fish_color_error a13b3b
set -g fish_color_param 170e0d
set -g fish_color_valid_path 912f18
set -g fish_color_option 2f5651
set -g fish_color_comment 634e4b
set -g fish_color_selection --background=f5dedb
set -g fish_color_operator 634945
set -g fish_color_escape 7b4132
set -g fish_color_autosuggestion 634e4b
set -g fish_color_cwd 99270a
set -g fish_color_hostname 81374a
set -g fish_color_status a13b3b
set -g fish_color_cancel 81374a
set -g fish_color_search_match --background=f5dedb

# Completion Pager Colors
set -g fish_pager_color_progress 2f5651
set -g fish_pager_color_prefix 912f18
set -g fish_pager_color_completion 170e0d
set -g fish_pager_color_description 634e4b
set -g fish_pager_color_selected_prefix 2f5651
set -g fish_pager_color_selected_completion 2f5651
set -g fish_pager_color_selected_background --background=f5dedb
