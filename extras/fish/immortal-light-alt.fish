# name: IMMORTAL LIGHT ALT colors for Fish
# url: https://fishshell.com/docs/current/index.html
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish/immortal-light-alt.fish
# author: Andrea Schiavini (original code by Casey Miller)

# use in ~/.config/fish/conf.d/

# preferred bg: c3d6df
# alt background: c3d6df

### Full palette. 
### Colors defined in neomdern/palette/IMMORTAL LIGHT ALT.lua
set -g alt 633d36 
set -g constant 3b3e7d 
set -g comment 4d5b66 
set -g fg 121b21 
set -g func 345779 
set -g keyword 32577b 
set -g number 2b6264 
set -g operator 4a5c69 
set -g property 121b21 
set -g str 315c87 
set -g type 445c73 

# Syntax Highlighting Colors
set -g fish_color_normal 121b21
set -g fish_color_command 345779
set -g fish_color_keyword 32577b
set -g fish_color_quote 315c87
set -g fish_color_redirection 3b3e7d
set -g fish_color_end 4a5c69
set -g fish_color_error a13b3b
set -g fish_color_param 121b21
set -g fish_color_valid_path 445c73
set -g fish_color_option 633d36
set -g fish_color_comment 4d5b66
set -g fish_color_selection --background=c3d6df
set -g fish_color_operator 4a5c69
set -g fish_color_escape 32577b
set -g fish_color_autosuggestion 4d5b66
set -g fish_color_cwd 315c87
set -g fish_color_hostname 2b6264
set -g fish_color_status a13b3b
set -g fish_color_cancel 2b6264
set -g fish_color_search_match --background=c3d6df

# Completion Pager Colors
set -g fish_pager_color_progress 633d36
set -g fish_pager_color_prefix 445c73
set -g fish_pager_color_completion 121b21
set -g fish_pager_color_description 4d5b66
set -g fish_pager_color_selected_prefix 633d36
set -g fish_pager_color_selected_completion 633d36
set -g fish_pager_color_selected_background --background=c3d6df
