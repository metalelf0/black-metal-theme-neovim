# name: KHOLD LIGHT ALT colors for Fish
# url: https://fishshell.com/docs/current/index.html
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish/khold-light-alt.fish
# author: Andrea Schiavini (original code by Casey Miller)

# use in ~/.config/fish/conf.d/

# preferred bg: e9bec7
# alt background: e9bec7

### Full palette. 
### Colors defined in neomdern/palette/KHOLD LIGHT ALT.lua
set -g alt 31594e 
set -g constant 684e31 
set -g comment 664d52 
set -g fg 1e1013 
set -g func 793834 
set -g keyword 4e5723 
set -g number 615029 
set -g operator 694a50 
set -g property 1e1013 
set -g str 4f5729 
set -g type 8f342e 

# Syntax Highlighting Colors
set -g fish_color_normal 1e1013
set -g fish_color_command 793834
set -g fish_color_keyword 4e5723
set -g fish_color_quote 4f5729
set -g fish_color_redirection 684e31
set -g fish_color_end 694a50
set -g fish_color_error a13b3b
set -g fish_color_param 1e1013
set -g fish_color_valid_path 8f342e
set -g fish_color_option 31594e
set -g fish_color_comment 664d52
set -g fish_color_selection --background=e9bec7
set -g fish_color_operator 694a50
set -g fish_color_escape 4e5723
set -g fish_color_autosuggestion 664d52
set -g fish_color_cwd 4f5729
set -g fish_color_hostname 615029
set -g fish_color_status a13b3b
set -g fish_color_cancel 615029
set -g fish_color_search_match --background=e9bec7

# Completion Pager Colors
set -g fish_pager_color_progress 31594e
set -g fish_pager_color_prefix 8f342e
set -g fish_pager_color_completion 1e1013
set -g fish_pager_color_description 664d52
set -g fish_pager_color_selected_prefix 31594e
set -g fish_pager_color_selected_completion 31594e
set -g fish_pager_color_selected_background --background=e9bec7
