# name: IMPALED-NAZARENE LIGHT colors for Fish
# url: https://fishshell.com/docs/current/index.html
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish/impaled-nazarene-light.fish
# author: Andrea Schiavini (original code by Casey Miller)

# use in ~/.config/fish/conf.d/

# preferred bg: edf1d5
# alt background: dbe7ac

### Full palette. 
### Colors defined in neomdern/palette/IMPALED-NAZARENE LIGHT.lua
set -g alt 365063 
set -g constant 5c6831 
set -g comment 61664d 
set -g fg 1f2112 
set -g func 6e602f 
set -g keyword 7b3632 
set -g number 813756 
set -g operator 5e6345 
set -g property 1f2112 
set -g str c30c03 
set -g type 755f1a 

# Syntax Highlighting Colors
set -g fish_color_normal 1f2112
set -g fish_color_command 6e602f
set -g fish_color_keyword 7b3632
set -g fish_color_quote c30c03
set -g fish_color_redirection 5c6831
set -g fish_color_end 5e6345
set -g fish_color_error a13b3b
set -g fish_color_param 1f2112
set -g fish_color_valid_path 755f1a
set -g fish_color_option 365063
set -g fish_color_comment 61664d
set -g fish_color_selection --background=edf1d5
set -g fish_color_operator 5e6345
set -g fish_color_escape 7b3632
set -g fish_color_autosuggestion 61664d
set -g fish_color_cwd c30c03
set -g fish_color_hostname 813756
set -g fish_color_status a13b3b
set -g fish_color_cancel 813756
set -g fish_color_search_match --background=edf1d5

# Completion Pager Colors
set -g fish_pager_color_progress 365063
set -g fish_pager_color_prefix 755f1a
set -g fish_pager_color_completion 1f2112
set -g fish_pager_color_description 61664d
set -g fish_pager_color_selected_prefix 365063
set -g fish_pager_color_selected_completion 365063
set -g fish_pager_color_selected_background --background=edf1d5
