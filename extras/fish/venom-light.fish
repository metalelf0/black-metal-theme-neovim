# name: VENOM LIGHT colors for Fish
# url: https://fishshell.com/docs/current/index.html
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish/venom-light.fish
# author: Andrea Schiavini (original code by Casey Miller)

# use in ~/.config/fish/conf.d/

# preferred bg: f3f2f2
# alt background: ddcacc

### Full palette. 
### Colors defined in neomdern/palette/VENOM LIGHT.lua
set -g alt 325c4f 
set -g constant 6f5034 
set -g comment 6c5151 
set -g fg 211212 
set -g func 793534 
set -g keyword 5e5526 
set -g number 764b32 
set -g operator 6f4e4e 
set -g property 211212 
set -g str 5e5527 
set -g type ae0200 

# Syntax Highlighting Colors
set -g fish_color_normal 211212
set -g fish_color_command 793534
set -g fish_color_keyword 5e5526
set -g fish_color_quote 5e5527
set -g fish_color_redirection 6f5034
set -g fish_color_end 6f4e4e
set -g fish_color_error a13b3b
set -g fish_color_param 211212
set -g fish_color_valid_path ae0200
set -g fish_color_option 325c4f
set -g fish_color_comment 6c5151
set -g fish_color_selection --background=f3f2f2
set -g fish_color_operator 6f4e4e
set -g fish_color_escape 5e5526
set -g fish_color_autosuggestion 6c5151
set -g fish_color_cwd 5e5527
set -g fish_color_hostname 764b32
set -g fish_color_status a13b3b
set -g fish_color_cancel 764b32
set -g fish_color_search_match --background=f3f2f2

# Completion Pager Colors
set -g fish_pager_color_progress 325c4f
set -g fish_pager_color_prefix ae0200
set -g fish_pager_color_completion 211212
set -g fish_pager_color_description 6c5151
set -g fish_pager_color_selected_prefix 325c4f
set -g fish_pager_color_selected_completion 325c4f
set -g fish_pager_color_selected_background --background=f3f2f2
