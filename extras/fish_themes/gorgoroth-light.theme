# name: GORGOROTH LIGHT colors for Fish Themes
# url: https://fishshell.com/docs/current/interactive.html#syntax-highlighting
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish_themes/gorgoroth-light.theme
# author: Andrea Schiavini (original code by Casey Miller)

# preferred bg: e6e0e2
# alt background: cfbfc7

# Syntax Highlighting Colors
set -g fish_color_normal 11090d
set -g fish_color_command 67492c
set -g fish_color_keyword 3d5723
set -g fish_color_quote 335511
set -g fish_color_redirection 535127
set -g fish_color_end 634554
set -g fish_color_error a13b3b
set -g fish_color_param 11090d
set -g fish_color_valid_path 5c4c3d
set -g fish_color_option 315459
set -g fish_color_comment 604954
set -g fish_color_selection --background=e6e0e2
set -g fish_color_operator 634554
set -g fish_color_escape 3d5723
set -g fish_color_autosuggestion 604954
set -g fish_color_cwd 335511
set -g fish_color_hostname 4d4f22
set -g fish_color_status a13b3b
set -g fish_color_cancel 4d4f22
set -g fish_color_search_match --background=e6e0e2

# Completion Pager Colors
set -g fish_pager_color_progress 315459
set -g fish_pager_color_prefix 5c4c3d
set -g fish_pager_color_completion 11090d
set -g fish_pager_color_description 604954
set -g fish_pager_color_selected_prefix 315459
set -g fish_pager_color_selected_completion 315459
set -g fish_pager_color_selected_background --background=e6e0e2
