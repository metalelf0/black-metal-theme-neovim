# name: DARK-FUNERAL LIGHT ALT colors for Fish Themes
# url: https://fishshell.com/docs/current/interactive.html#syntax-highlighting
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish_themes/dark-funeral-light-alt.theme
# author: Andrea Schiavini (original code by Casey Miller)

# preferred bg: c0cbed
# alt background: c0cbed

# Syntax Highlighting Colors
set -g fish_color_normal 121621
set -g fish_color_command 345779
set -g fish_color_keyword 6c4e2c
set -g fish_color_quote 7f4200
set -g fish_color_redirection 3b3d7d
set -g fish_color_end 4a5369
set -g fish_color_error a13b3b
set -g fish_color_param 121621
set -g fish_color_valid_path 20578e
set -g fish_color_option 633d36
set -g fish_color_comment 4f5669
set -g fish_color_selection --background=c0cbed
set -g fish_color_operator 4a5369
set -g fish_color_escape 6c4e2c
set -g fish_color_autosuggestion 4f5669
set -g fish_color_cwd 7f4200
set -g fish_color_hostname 813b37
set -g fish_color_status a13b3b
set -g fish_color_cancel 813b37
set -g fish_color_search_match --background=c0cbed

# Completion Pager Colors
set -g fish_pager_color_progress 633d36
set -g fish_pager_color_prefix 20578e
set -g fish_pager_color_completion 121621
set -g fish_pager_color_description 4f5669
set -g fish_pager_color_selected_prefix 633d36
set -g fish_pager_color_selected_completion 633d36
set -g fish_pager_color_selected_background --background=c0cbed
