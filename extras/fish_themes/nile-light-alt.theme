# name: NILE LIGHT ALT colors for Fish Themes
# url: https://fishshell.com/docs/current/interactive.html#syntax-highlighting
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish_themes/nile-light-alt.theme
# author: Andrea Schiavini (original code by Casey Miller)

# preferred bg: e5c4a4
# alt background: e5c4a4

# Syntax Highlighting Colors
set -g fish_color_normal 17130d
set -g fish_color_command 555525
set -g fish_color_keyword 6c4e2c
set -g fish_color_quote 634f3a
set -g fish_color_redirection 445a2b
set -g fish_color_end 5d5141
set -g fish_color_error a13b3b
set -g fish_color_param 17130d
set -g fish_color_valid_path 565633
set -g fish_color_option 364563
set -g fish_color_comment 5d5346
set -g fish_color_selection --background=e5c4a4
set -g fish_color_operator 5d5141
set -g fish_color_escape 6c4e2c
set -g fish_color_autosuggestion 5d5346
set -g fish_color_cwd 634f3a
set -g fish_color_hostname 813a37
set -g fish_color_status a13b3b
set -g fish_color_cancel 813a37
set -g fish_color_search_match --background=e5c4a4

# Completion Pager Colors
set -g fish_pager_color_progress 364563
set -g fish_pager_color_prefix 565633
set -g fish_pager_color_completion 17130d
set -g fish_pager_color_description 5d5346
set -g fish_pager_color_selected_prefix 364563
set -g fish_pager_color_selected_completion 364563
set -g fish_pager_color_selected_background --background=e5c4a4
