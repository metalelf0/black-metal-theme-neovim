# name: BATHORY LIGHT ALT colors for Fish Themes
# url: https://fishshell.com/docs/current/interactive.html#syntax-highlighting
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish_themes/bathory-light-alt.theme
# author: Andrea Schiavini (original code by Casey Miller)

# preferred bg: eac2b8
# alt background: eac2b8

# Syntax Highlighting Colors
set -g fish_color_normal 1e1510
set -g fish_color_command 6e4b2f
set -g fish_color_keyword 6c4e2c
set -g fish_color_quote 7f4200
set -g fish_color_redirection 5a552b
set -g fish_color_end 634f45
set -g fish_color_error a13b3b
set -g fish_color_param 1e1510
set -g fish_color_valid_path 8a3c00
set -g fish_color_option 32595c
set -g fish_color_comment 63524b
set -g fish_color_selection --background=eac2b8
set -g fish_color_operator 634f45
set -g fish_color_escape 6c4e2c
set -g fish_color_autosuggestion 63524b
set -g fish_color_cwd 7f4200
set -g fish_color_hostname 813b37
set -g fish_color_status a13b3b
set -g fish_color_cancel 813b37
set -g fish_color_search_match --background=eac2b8

# Completion Pager Colors
set -g fish_pager_color_progress 32595c
set -g fish_pager_color_prefix 8a3c00
set -g fish_pager_color_completion 1e1510
set -g fish_pager_color_description 63524b
set -g fish_pager_color_selected_prefix 32595c
set -g fish_pager_color_selected_completion 32595c
set -g fish_pager_color_selected_background --background=eac2b8
