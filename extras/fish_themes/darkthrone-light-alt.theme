# name: DARKTHRONE LIGHT ALT colors for Fish Themes
# url: https://fishshell.com/docs/current/interactive.html#syntax-highlighting
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish_themes/darkthrone-light-alt.theme
# author: Andrea Schiavini (original code by Casey Miller)

# preferred bg: f2f2f0
# alt background: f2f2f0

# Syntax Highlighting Colors
set -g fish_color_normal 1a1a1a
set -g fish_color_command 555555
set -g fish_color_keyword 4a4a4a
set -g fish_color_quote 000000
set -g fish_color_redirection 5e5e5e
set -g fish_color_end 666666
set -g fish_color_error a13b3b
set -g fish_color_param 1a1a1a
set -g fish_color_valid_path 000000
set -g fish_color_option 444444
set -g fish_color_comment 6a6a6a
set -g fish_color_selection --background=f2f2f0
set -g fish_color_operator 666666
set -g fish_color_escape 4a4a4a
set -g fish_color_autosuggestion 6a6a6a
set -g fish_color_cwd 000000
set -g fish_color_hostname 5e5e5e
set -g fish_color_status a13b3b
set -g fish_color_cancel 5e5e5e
set -g fish_color_search_match --background=f2f2f0

# Completion Pager Colors
set -g fish_pager_color_progress 444444
set -g fish_pager_color_prefix 000000
set -g fish_pager_color_completion 1a1a1a
set -g fish_pager_color_description 6a6a6a
set -g fish_pager_color_selected_prefix 444444
set -g fish_pager_color_selected_completion 444444
set -g fish_pager_color_selected_background --background=f2f2f0
