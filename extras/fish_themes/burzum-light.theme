# name: BURZUM LIGHT colors for Fish Themes
# url: https://fishshell.com/docs/current/interactive.html#syntax-highlighting
# upstream: https://github.com/metalelf0/black-metal.nvim/raw/main/extras/fish_themes/burzum-light.theme
# author: Andrea Schiavini (original code by Casey Miller)

# preferred bg: e1efe8
# alt background: e8d5ba

# Syntax Highlighting Colors
set -g fish_color_normal 12211a
set -g fish_color_command 2c6749
set -g fish_color_keyword 476529
set -g fish_color_quote 3d6714
set -g fish_color_redirection 306562
set -g fish_color_end 456354
set -g fish_color_error a13b3b
set -g fish_color_param 12211a
set -g fish_color_valid_path 35644c
set -g fish_color_option 63365c
set -g fish_color_comment 4b6357
set -g fish_color_selection --background=e1efe8
set -g fish_color_operator 456354
set -g fish_color_escape 476529
set -g fish_color_autosuggestion 4b6357
set -g fish_color_cwd 3d6714
set -g fish_color_hostname 5b5d28
set -g fish_color_status a13b3b
set -g fish_color_cancel 5b5d28
set -g fish_color_search_match --background=e1efe8

# Completion Pager Colors
set -g fish_pager_color_progress 63365c
set -g fish_pager_color_prefix 35644c
set -g fish_pager_color_completion 12211a
set -g fish_pager_color_description 4b6357
set -g fish_pager_color_selected_prefix 63365c
set -g fish_pager_color_selected_completion 63365c
set -g fish_pager_color_selected_background --background=e1efe8
